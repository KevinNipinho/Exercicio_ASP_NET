
@model ExercicioASP.NET.Models.Evento

<h2>Cadastrar Evento</h2>

<form asp-action="Criar" method="post">

    <div>
        <label asp-for="Nome">Nome:</label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="Descricao">Descrição:</label>
        <textarea asp-for="Descricao"></textarea>
        <span asp-validation-for="Descricao"></span>
    </div>

    <div>
        <label asp-for="Local">Local:</label>
        <input asp-for="Local" />
        <span asp-validation-for="Local"></span>
    </div>

    <div>
        <label asp-for="DataEvento">Data do evento:</label>
        <input asp-for="DataEvento" type="date" />
        <span asp-validation-for="DataEvento"></span>
    </div>

    <div>
        <label asp-for="QuantidadeVagas">Quantidade de vagas:</label>
        <input asp-for="QuantidadeVagas" type="number" />
        <span asp-validation-for="QuantidadeVagas"></span>
    </div>

    <div>
        <label asp-for="ValorIngresso">Valor do ingresso:</label>
        <input asp-for="ValorIngresso" type="number" step="0.01" />
        <span asp-validation-for="ValorIngresso"></span>
    </div>

    <button type="submit">Cadastrar</button>

</form>

<a asp-action="Index">Voltar para listagem</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
