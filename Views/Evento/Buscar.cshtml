@model ExercicioASP.NET.ViewModels.BuscaEventoViewModel
@{
  ViewData["Title"] = "Buscar evento";
}

<h1>Buscar eventos</h1>

<form asp-action="Buscar" method="post">
    <div>
        <label asp-for="NomeBusca">Nome:</label>
        <input asp-for="NomeBusca" placeholder="Nome do evento..." />
    </div>

    <div>
        <label asp-for="LocalBusca">Local:</label>
        <input asp-for="LocalBusca" placeholder="Local do evento..." />
    </div>

    <div>
        <label asp-for="DataInicial">Data inicial:</label>
        <input asp-for="DataInicial" type="date" />
    </div>

    <button type="submit">Buscar</button>

    <a asp-action="Index">Voltar para listagem</a>
</form>

@if (Model.Resultados.Any())
{
  <table>
    <tr>
      <th>Nome</th>
      <th>Local</th>
      <th>DataEvento</th>
      <th>QuantidadeVagas</th>
      <th>ValorIngresso</th>
    </tr>

    @foreach (Evento evento in Model.Resultados)
    {
      <tr>
        <td>@evento.Nome</td>
        <td>@evento.Local</td>
        <td>@evento.DataEvento.ToString("dd/MM/yyyy")</td>
        <td>@evento.QuantidadeVagas</td>
        <td>@evento.ValorIngresso.ToString("C")</td>
      </tr>
    }
  </table>
}